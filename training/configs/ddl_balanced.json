{
  "model": {
    "d_model": 192,
    "n_heads": 6,
    "n_layers": 6,
    "d_ff": 768,
    "max_len": 768,
    "dropout": 0.08
  },
  "tokenizer": {
    "kind": "byte"
  },
  "training": {
    "seed": 42,
    "batch_size": 2,
    "grad_accumulation": 2,
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "shuffle_buffer": 512,
    "epochs": 20,
    "max_steps": 8000,
    "eval_every": 500,
    "save_every": 500
  }
}
