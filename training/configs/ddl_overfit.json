{
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "d_ff": 512,
    "max_len": 768,
    "dropout": 0.05
  },
  "tokenizer": {
    "kind": "byte"
  },
  "training": {
    "seed": 42,
    "batch_size": 1,
    "grad_accumulation": 1,
    "learning_rate": 0.00015,
    "weight_decay": 0.01,
    "epochs": 400,
    "max_steps": 400,
    "eval_every": 10,
    "save_every": 50
  }
}
