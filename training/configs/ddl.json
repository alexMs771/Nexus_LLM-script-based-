{
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "d_ff": 512,
    "max_len": 768,
    "dropout": 0.1
  },
  "tokenizer": {
    "kind": "byte"
  },
  "training": {
    "seed": 42,
    "batch_size": 4,
    "grad_accumulation": 4,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "epochs": 200,
    "max_steps": 200,
    "eval_every": 1,
    "save_every": 50
  }
}
