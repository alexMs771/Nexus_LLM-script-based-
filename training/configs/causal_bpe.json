{
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "d_ff": 512,
    "max_len": 128,
    "dropout": 0.1
  },
  "tokenizer": {
    "kind": "byte_bpe",
    "vocab_size": 300,
    "text_limit": 1000,
    "byte_limit": 250000
  },
  "training": {
    "seed": 42,
    "batch_size": 4,
    "grad_accumulation": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "epochs": 3,
    "max_steps": 300,
    "eval_every": 100,
    "save_every": 100
  }
}
