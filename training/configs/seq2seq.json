{
  "model": {
    "d_model": 192,
    "n_heads": 6,
    "n_encoder_layers": 4,
    "n_decoder_layers": 4,
    "d_ff": 768,
    "max_source_len": 768,
    "max_target_len": 320,
    "dropout": 0.1
  },
  "tokenizer": {
    "kind": "byte_bpe",
    "vocab_size": 512,
    "text_limit": 10000,
    "byte_limit": 750000
  },
  "training": {
    "seed": 42,
    "batch_size": 8,
    "grad_accumulation": 4,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "shuffle_buffer": 1024,
    "epochs": 3,
    "max_steps": 8000,
    "eval_every": 250,
    "save_every": 250
  }
}
