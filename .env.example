# Serving
SQL_LLM_HOST=127.0.0.1
SQL_LLM_PORT=8000
SQL_LLM_DEFAULT_MODEL=ollama

# Approach A checkpoint (created by training/train_scratch.py)
SQL_LLM_SCRATCH_DIR=artifacts/scratch

# Optional pretrained baseline. Ollama must be installed separately.
SQL_LLM_OLLAMA_URL=http://127.0.0.1:11434
SQL_LLM_OLLAMA_MODEL=qwen2.5-coder:0.5b
SQL_LLM_OLLAMA_TIMEOUT_SECONDS=30

# Safety: generated DDL is never executed unless this is true
SQL_LLM_ENABLE_EXECUTION=false
SQL_LLM_ALLOW_DESTRUCTIVE=false
SQL_LLM_RETRY_INVALID_GENERATION=false
SQL_LLM_API_KEY=
